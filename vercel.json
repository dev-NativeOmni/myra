{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": [
        "sin1"
    ],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 60,
            "memory": 1024,
            "excludeFiles": "{.git/**,.github/**,.claude/**,.grok/**,node_modules/**,tests/**,storage/**,database/*.sqlite,*.md,.env,.env.*,vercel.json,.vercelignore}"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ],
    "headers": [
        {
            "source": "/build/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
